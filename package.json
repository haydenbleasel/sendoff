{
  "name": "sendoff",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "types": "turbo run types",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "bump-deps": "npx npm-check-updates --deep -u && bun install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.4"
}
