{
  "name": "sendoff",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "types": "turbo run types",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "turbo run build && changeset publish",
    "bump-deps": "npx npm-check-updates --deep -u && bun install",
    "prepare": "husky",
    "setup": "cd apps/app && bun run setup",
    "deploy": "cd apps/app && bun run deploy",
    "update": "cd apps/app && bun run update"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.4"
}
