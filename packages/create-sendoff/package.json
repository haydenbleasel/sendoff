{
  "name": "create-sendoff",
  "version": "0.0.0",
  "description": "Deploy Sendoff, which emails your list (newsletters, launches, announcements) from your agent, into your own Cloudflare and AWS accounts.",
  "keywords": [
    "broadcast",
    "cloudflare",
    "mcp",
    "newsletter",
    "sendoff",
    "ses"
  ],
  "homepage": "https://sendoff.dev",
  "bugs": "https://github.com/haydenbleasel/sendoff/issues",
  "license": "MIT",
  "author": "Hayden Bleasel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydenbleasel/sendoff.git",
    "directory": "packages/create-sendoff"
  },
  "bin": {
    "create-sendoff": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/index.js",
    "prepack": "bun run build",
    "types": "tsgo --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.12"
  }
}
