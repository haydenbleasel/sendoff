{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendoff",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "MCP_TOKEN",
      "TOKEN_SECRET",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  // `bun run setup` fills these in. Override them locally in .dev.vars.
  "vars": {
    "PUBLIC_URL": "",
    "SES_REGION": "us-east-1",
    "SES_CONFIGURATION_SET": "sendoff",
    "SES_EVENTS_TOPIC_ARN": "",
    "TURNSTILE_SITE_KEY": "",
  },
}
