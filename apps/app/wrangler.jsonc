{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: OAuth client metadata documents are
  // fetched from URLs clients supply, so keep those fetches off private hosts.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendoff",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "MCP_TOKEN",
      "TOKEN_SECRET",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  // Workers AI, for the promotion check in prepare_send when there's no
  // postal address. It always runs on Cloudflare, even in local dev.
  "ai": { "binding": "AI", "remote": true },
  // OAuth grants and tokens for claude.ai and Claude Desktop connectors.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "sendoff-send" }],
    "consumers": [
      {
        "queue": "sendoff-send",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 1,
      },
    ],
  },
  // Every 5 minutes: restart sends whose queue chain stalled.
  // Daily: purge expired OAuth grants and tokens.
  "triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] },
  // `bun run setup` fills these in. Override them locally in .dev.vars.
  "vars": {
    "PUBLIC_URL": "",
    "SES_REGION": "us-east-1",
    "SES_CONFIGURATION_SET": "sendoff",
    "SES_EVENTS_TOPIC_ARN": "",
    "TURNSTILE_SITE_KEY": "",
  },
}
