{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "types": "wrangler types --strict-vars false --check && tsgo --noEmit",
    "typegen": "wrangler types --strict-vars false",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "bench": "bun build scripts/bench-render.ts --target node --conditions workerd --conditions worker --define process.env.NODE_ENV='\"production\"' --outfile .bench/bench.mjs && node .bench/bench.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-extension-directive": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
