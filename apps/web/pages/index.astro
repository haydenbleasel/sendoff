---
import Icon from "blume/components/Icon.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import Arrow from "./_home/arrow.astro";
import Calculator from "./_home/calculator.astro";
import Chat from "./_home/chat.astro";
import CopyCommand from "./_home/copy-command.astro";
import Email from "./_home/email.astro";
import Flaps from "./_home/flaps.astro";
import Mark from "./_home/mark.astro";

const { config } = data;

const DOCS = "/docs";
const QUICKSTART = "/docs/quickstart";
const CREATE_COMMAND = "bun create sendoff";
const REPO = "https://github.com/haydenbleasel/sendoff";

// The hero conversation, from first draft to send.
const chat = [
  { from: "you", messages: [{ text: "Draft issue 24 from my last three posts." }] },
  {
    from: "agent",
    messages: [
      { text: "“Shipping in public” is drafted, 612 words. The preview is ready." },
      { link: true, text: "news.example.com/preview/x7Kp2Q" },
    ],
  },
  { from: "you", messages: [{ text: "Send me a test." }] },
  { from: "agent", messages: [{ text: "Sent to hello@example.com. Preflight passed." }] },
  { from: "you", messages: [{ text: "Looks good. Send it." }] },
  { from: "agent", messages: [{ text: "Issue 24 is going out to 6,042 subscribers." }] },
] as const;

// The edits that build the email mock (_home/email.astro), one block at a time.
const emailChat = [
  {
    from: "you",
    messages: [{ text: "Start issue 24 with a short intro about shipping in public." }],
  },
  { from: "agent", messages: [{ text: "Drafted “Shipping in public” with a short intro." }] },
  { from: "you", messages: [{ text: "Add a button to read the full post." }] },
  { from: "agent", messages: [{ text: "Added “Read the full post” under the intro." }] },
  { from: "you", messages: [{ text: "Now a callout with the short version." }] },
  {
    from: "agent",
    messages: [{ text: "Done: “Ship small, write it down and reply to everyone.”" }],
  },
  { from: "you", messages: [{ text: "And list what’s in the post." }] },
  { from: "agent", messages: [{ text: "Added two bullets after the callout." }] },
] as const;

// The live preview's toggles (apps/app/src/preview-page.ts). The first option
// in each is the default. A click sets `data-<key>` on the mock to the option's
// value, and its group-data variants restyle it. Options with an icon (Lucide,
// via Blume) show it instead of the label.
const previewControls = [
  {
    key: "view",
    label: "View",
    options: [
      { label: "Email", value: "email" },
      { label: "Text", value: "text" },
    ],
  },
  {
    key: "width",
    label: "Width",
    options: [
      { icon: "monitor", label: "Desktop", value: "desktop" },
      { icon: "smartphone", label: "Mobile", value: "mobile" },
    ],
  },
  {
    key: "scheme",
    label: "Theme",
    options: [
      { icon: "sun", label: "Light", value: "light" },
      { icon: "moon", label: "Dark", value: "dark" },
    ],
  },
];

// The plain-text version of issue 24, laid out the way apps/app/src/email/text.ts
// writes it from the Markdown.
const issueText = `Shipping in public
==================

Three months of building in the open, and what I’d do differently next time.

Read the full post: https://example.com/shipping-in-public

The short version

Ship small, write it down and reply to everyone.

- Why I post unfinished work
- The tools I use every week

--

You're receiving this because you subscribed to The Sendoff Quarterly.

Unsubscribe: https://news.example.com/unsubscribe/5mXq8R`;

const previewFeatures = [
  {
    body: "Desktop and mobile, light and dark, and the plain-text version.",
    icon: "monitor-smartphone",
    title: "Every view",
  },
  {
    body: "Edits show up within a couple of seconds, so you can read along as you ask for changes.",
    icon: "refresh-cw",
    title: "Live",
  },
  {
    body: "Anything that won’t render is listed by line, so your agent can fix it before you send.",
    icon: "triangle-alert",
    title: "Problems flagged",
  },
];

// The checks `prepare_send` runs before a send goes out (`doctor` plus the test
// match, per SPEC.md), as they'd read for the hero's issue 24.
const preflightChecks = [
  { detail: "DKIM on example.com", label: "Domain verified" },
  { detail: "bounce.example.com", label: "Custom MAIL FROM" },
  { detail: "p=none on example.com", label: "DMARC record" },
  { detail: "Out of the SES sandbox", label: "Production access" },
  { detail: "50,000 a day", label: "Sending quota" },
  { detail: "Wired to Sendoff", label: "Bounces and complaints" },
  { detail: "Sent at 08:52", label: "Test matches the draft" },
];

// Deliverability defaults that are always on (SPEC.md).
const deliverability = [
  {
    body: "DKIM, a custom MAIL FROM and DMARC on your own domain, set up for you.",
    icon: "shield-check",
    title: "Authenticated",
  },
  {
    body: "Every email carries one-click unsubscribe headers and a visible link, plus your postal address if you've set one.",
    icon: "mail-x",
    title: "One-click unsubscribe",
  },
  {
    body: "Signups confirm by email, and bounces and complaints come off the list on their own.",
    icon: "user-check",
    title: "A clean list",
  },
];

// Placeholder issues for the status table; swap in real ones before launch.
// Counts are what `send_status` reports: sent, bounced and unsubscribed.
const issues = [
  {
    bounced: 3,
    live: true,
    number: 24,
    recipients: 6042,
    sent: 2410,
    sentAt: "2026-10-31T09:00",
    title: "Shipping in public",
    unsubscribed: 1,
  },
  {
    bounced: 12,
    number: 23,
    recipients: 5918,
    sent: 5918,
    sentAt: "2026-08-01T09:00",
    title: "What I learned building Blume",
    unsubscribed: 9,
  },
  {
    bounced: 9,
    number: 22,
    recipients: 5701,
    sent: 5701,
    sentAt: "2026-05-02T09:00",
    title: "Notes on open source",
    unsubscribed: 7,
  },
  {
    bounced: 14,
    number: 21,
    recipients: 5466,
    sent: 5466,
    sentAt: "2026-01-31T09:00",
    title: "A year of building",
    unsubscribed: 11,
  },
];

const formatCount = (n: number) => n.toLocaleString("en-US");

// "Oct 31, 09:00". Date and time are formatted separately because a combined
// formatter joins them with " at ".
const dayFormat = new Intl.DateTimeFormat("en-US", { day: "numeric", month: "short" });

const timeFormat = new Intl.DateTimeFormat("en-US", {
  hour: "2-digit",
  hourCycle: "h23",
  minute: "2-digit",
});

const formatSentAt = (sentAt: string) => {
  const date = new Date(sentAt);

  return `${dayFormat.format(date)}, ${timeFormat.format(date)}`;
};

// `code` is what you type or say at each step.
const steps = [
  {
    body: "One command clones Sendoff and runs setup. It creates the database, queue and SES identity, writes your DNS records and asks AWS for production access.",
    code: CREATE_COMMAND,
    href: QUICKSTART,
    link: "Setup guide",
    number: "1",
    title: "Deploy",
  },
  {
    body: "Add one URL as a connector in claude.ai or Claude Desktop, or with the command setup prints for Claude Code and Codex.",
    code: "news.example.com/mcp",
    href: "/docs/connect",
    link: "Connect your agent",
    number: "2",
    title: "Connect",
  },
  {
    body: "Ask for a draft, check the preview and send yourself a test. Nothing goes out until you say so.",
    code: "“Send it.”",
    href: "/docs/guides/sending",
    link: "How sending works",
    number: "3",
    title: "Send",
  },
];

// Shared class lists for repeated elements. Headings inherit Blume's -0.05em
// display tracking from its base styles, so they don't set their own.
const autoFit = "grid grid-cols-[repeat(auto-fit,minmax(min(--spacing(75),100%),1fr))] gap-12";

const textLink =
  "inline-flex items-center gap-2 font-medium text-foreground no-underline hover:text-muted-foreground";

const displayHeading = "max-w-[20ch] text-display font-medium text-balance";

const sectionHeading = "max-w-[30ch] text-4xl font-medium text-balance lg:text-5xl";

const lead = "max-w-[48ch] text-lg/7 text-pretty text-muted-foreground";

const inlineLink =
  "font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground";
---

<PageLayout
  site={{ description: config.description, title: config.title }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt="The Sendoff mark and SENDOFF spelled out on split-flap tiles."
  ogImageSize={{ height: 630, width: 1200 }}
  structuredDataEnabled={config.structuredData}
  page={{
    description: config.description,
    route: "/",
    title: "Sendoff — Say “send it.” Sendoff handles the rest.",
  }}
>
  <div class="mx-auto max-w-300 px-5 text-foreground sm:px-8 lg:px-12">
    <section class="flex flex-col items-center gap-7.5 pt-20 pb-16 text-center md:pt-44 md:pb-28">
      <Flaps text="09:00 NO.24" label="09:00, issue 24" class="sendoff-enter" />
      <h1 class:list={[displayHeading, "sendoff-enter [--i:1]"]}>
        Say <span class="sendoff-highlight text-nowrap">“send it.”</span> Sendoff handles the rest.
      </h1>
      <p class="sendoff-enter max-w-[40ch] text-xl/8 text-pretty text-muted-foreground [--i:2]">
        Newsletters and announcements for your list, sent from your own Cloudflare and AWS accounts
        and run from Claude or Codex.
      </p>
      <div
        class="sendoff-enter flex flex-wrap items-center justify-center gap-x-7 gap-y-3 [--i:3]"
      >
        <CopyCommand command={CREATE_COMMAND} />
        <a href={DOCS} class:list={[textLink, "min-h-11 text-base"]}>
          Read the docs <Arrow />
        </a>
      </div>
    </section>

    <section
      class="flex justify-center rounded-4xl bg-muted px-4 py-8 sm:px-12 sm:py-22"
      aria-label="Example conversation"
    >
      <div class="w-full max-w-160">
        <Chat turns={chat} entrance="load" />
      </div>
    </section>

    <section class="flex flex-col gap-10 pt-24 md:pt-44">
      <div data-reveal>
        <h2 class={sectionHeading}>Your agent writes it. React&nbsp;Email makes it look good.</h2>
        <p class:list={[lead, "mt-6"]}>
          Connect Sendoff to Claude or Codex and describe the issue you want. Your agent writes and
          edits it, and Sendoff renders it with{" "}
          <a href="https://react.email" class={inlineLink}>React Email</a> into a polished layout,
          with buttons, callouts, images and dark mode taken care of.
        </p>
      </div>
      <figure
        class="grid gap-4 rounded-4xl bg-muted p-4 sm:p-10 lg:grid-cols-[1fr_auto_1fr] lg:gap-6"
        role="img"
        aria-label="A chat where your agent builds issue 24 block by block, next to the email it renders"
      >
        <div
          class="flex flex-col justify-end rounded-2xl bg-background p-4 ring-1 ring-black/5 sm:p-6 dark:bg-white/5 dark:ring-white/10"
        >
          <Chat turns={emailChat} onCard small entrance="view" />
        </div>
        <div class="flex items-center justify-center text-muted-foreground">
          <div class="rotate-90 lg:rotate-0"><Arrow /></div>
        </div>
        <div class="grid overflow-hidden rounded-2xl ring-1 ring-black/5 dark:ring-white/10">
          <Email full />
        </div>
      </figure>
    </section>

    <section class="grid items-center gap-12 pt-24 md:pt-44 lg:grid-cols-[2fr_3fr]">
      <div data-reveal>
        <h2 class={sectionHeading}>Your agent sends a link when it’s ready.</h2>
        <p class:list={[lead, "mt-6"]}>
          Open it on your phone or laptop and see the issue the way subscribers will, before anything
          goes out.
        </p>
        <dl class="mt-10 divide-y divide-border">
          {
            previewFeatures.map((feature) => (
              <div class="py-5 first:pt-0 last:pb-0">
                <dt class="flex gap-4 text-base/7 font-medium">
                  <Icon name={feature.icon} size={20} class="h-lh shrink-0" />
                  {feature.title}
                </dt>
                <dd class="pl-9 text-base/7 text-pretty text-muted-foreground">{feature.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure
        class="group/preview rounded-4xl bg-muted p-3 sm:p-6 [--reveal-delay:120ms]"
        aria-label="The live preview of issue 24"
        data-preview
        data-reveal
        data-scheme="light"
        data-view="email"
        data-width="desktop"
      >
        <div
          class="overflow-hidden rounded-2xl bg-background ring-1 ring-black/5 dark:bg-white/5 dark:ring-white/10"
        >
          <p class="border-b border-border px-4 py-2.5 font-mono text-xs text-muted-foreground">
            news.example.com/preview/x7Kp2Q
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b border-border px-4 py-3">
            <p class="flex min-w-0 flex-1 basis-32 items-center gap-2.5 text-sm font-semibold">
              <span class="size-2 shrink-0 rounded-full bg-(--sendoff-signal)"></span>
              <span class="truncate">Shipping in public</span>
            </p>
            <div class="flex gap-2">
              {
                previewControls.map((control) => (
                  <div
                    aria-label={control.label}
                    class="inline-flex rounded-lg p-0.5 ring-1 ring-border ring-inset"
                    role="group"
                  >
                    {control.options.map((option, index) => (
                      <button
                        aria-label={option.icon ? option.label : undefined}
                        aria-pressed={index === 0 ? "true" : "false"}
                        class:list={[
                          "grid h-7 cursor-pointer place-items-center rounded-md text-[0.8125rem] text-muted-foreground hover:text-foreground aria-pressed:bg-foreground aria-pressed:text-background",
                          option.icon ? "w-7" : "px-2.5",
                        ]}
                        data-preview-key={control.key}
                        data-preview-value={option.value}
                        title={option.icon ? option.label : undefined}
                        type="button"
                      >
                        {option.icon ? <Icon name={option.icon} size={16} /> : option.label}
                      </button>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>
          <div class="bg-muted/60 p-3 sm:p-5 dark:bg-black/20">
            {/* Mobile narrows the frame toward a phone's width, as the real preview does. */}
            <div
              class="mx-auto h-96 max-w-full overflow-hidden rounded-xl bg-white ring-1 ring-black/5 mask-b-from-80% transition-[max-width] duration-150 ease-out group-data-[scheme=dark]/preview:bg-zinc-950 group-data-[scheme=dark]/preview:ring-white/10 group-data-[width=mobile]/preview:max-w-80 motion-reduce:transition-none sm:h-104"
            >
              <div
                class="flex flex-col gap-3 border-b border-zinc-200 px-6 pt-5 pb-4 group-data-[scheme=dark]/preview:border-zinc-800 sm:px-8"
              >
                <p
                  class="text-lg font-semibold text-zinc-950 group-data-[scheme=dark]/preview:text-zinc-50"
                >
                  Shipping in public
                </p>
                <div class="flex items-center gap-3 text-sm">
                  <span
                    class="grid size-9 shrink-0 place-items-center rounded-full bg-zinc-900 font-semibold text-white group-data-[scheme=dark]/preview:bg-zinc-100 group-data-[scheme=dark]/preview:text-zinc-900"
                    >S</span
                  >
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-zinc-500 group-data-[scheme=dark]/preview:text-zinc-400">
                      <span
                        class="font-semibold text-zinc-950 group-data-[scheme=dark]/preview:text-zinc-50"
                        >The Sendoff Quarterly</span
                      >{" "}
                      &lt;hello@example.com&gt;
                    </p>
                    <p class="text-zinc-500 group-data-[scheme=dark]/preview:text-zinc-400">
                      to you
                    </p>
                  </div>
                  <p
                    class="text-zinc-500 tabular-nums group-data-[scheme=dark]/preview:text-zinc-400"
                  >
                    09:00
                  </p>
                </div>
              </div>
              <div class="group-data-[view=text]/preview:hidden">
                <Email full scheme="preview" />
              </div>
              <pre
                class="hidden px-6 py-5 font-mono text-[0.8125rem]/6 whitespace-pre-wrap text-zinc-700 group-data-[scheme=dark]/preview:text-zinc-300 group-data-[view=text]/preview:block sm:px-8">{issueText}</pre>
            </div>
          </div>
        </div>
      </figure>
    </section>

    <section id="pricing" class="flex scroll-mt-24 flex-col gap-12 pt-24 md:pt-44">
      <div data-reveal>
        <h2 class={sectionHeading}>Host it yourself. Skip the subscription.</h2>
        <p class:list={[lead, "mt-6"]}>
          Sendoff runs in your own Cloudflare account and sends through your own Amazon SES, so you
          pay them directly and nobody else. Pick the service you’re on now and move the sliders to see
          how the bills compare.
        </p>
      </div>
      <div class="[--reveal-delay:120ms]" data-reveal>
        <Calculator />
      </div>
    </section>

    <section class="grid gap-12 pt-24 md:pt-44 lg:grid-cols-[2fr_3fr]">
      <div data-reveal>
        <h2 class={sectionHeading}>Nothing leaves until preflight passes.</h2>
        <p class:list={[lead, "mt-6"]}>
          Before every send, Sendoff checks your domain, your SES account and your latest test, and
          won’t go until everything passes.
        </p>
        <dl class="mt-10 divide-y divide-border">
          {
            deliverability.map((item) => (
              <div class="py-5 first:pt-0 last:pb-0">
                <dt class="flex gap-4 text-base/7 font-medium">
                  <Icon name={item.icon} size={20} class="h-lh shrink-0" />
                  {item.title}
                </dt>
                <dd class="pl-9 text-base/7 text-pretty text-muted-foreground">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure
        class="flex flex-col rounded-4xl bg-muted p-3 sm:p-6"
        role="img"
        aria-label="Preflight for issue 24, with every check passed"
        data-reveal="contents"
      >
        <div
          class="flex flex-1 flex-col overflow-hidden rounded-2xl bg-background ring-1 ring-black/5 dark:bg-white/5 dark:ring-white/10"
        >
          <div
            class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border px-5 py-4 sm:px-6"
          >
            <p class="text-base font-semibold">Preflight</p>
            <p class="text-sm text-muted-foreground">Issue 24 · Shipping in public</p>
          </div>
          {/* On desktop the card takes the copy's height and the checks share it evenly. */}
          <ul role="list" class="flex flex-1 flex-col divide-y divide-border px-5 sm:px-6">
            {
              preflightChecks.map((check, index) => (
                <li class="flex flex-1 items-center gap-3 py-3.5">
                  <span class="sendoff-check grid shrink-0" style={`--i: ${index}`}>
                    <Icon
                      name="circle-check"
                      size={20}
                      class="text-emerald-600 dark:text-emerald-400"
                    />
                  </span>
                  {/* Phones stack the detail under the label; wider, they share a row. */}
                  <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                    <p class="text-base font-medium">{check.label}</p>
                    <p class="font-mono text-sm text-muted-foreground sm:text-right">
                      {check.detail}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </figure>
    </section>

    <section class="flex flex-col gap-10 pt-24 md:pt-44">
      <div class="grid gap-6 lg:grid-cols-2 lg:items-end" data-reveal>
        <h2 class={sectionHeading}>Ask for the status of any send.</h2>
        <p class="max-w-[48ch] text-lg/7 text-pretty text-muted-foreground lg:justify-self-end">
          Your agent can tell you how far a send has got, what bounced and who unsubscribed. Bounces
          and complaints come off the list on their own.
        </p>
      </div>
      {/* The table needs about 900px, so narrower screens get a stacked list of the same sends. */}
      <div class="[--reveal-delay:120ms]" data-reveal>
        <ul role="list" class="border-t border-foreground lg:hidden">
          {
            issues.map((issue) => (
              <li class="flex flex-col gap-3 border-b border-border py-5">
                <div class="flex min-h-6.25 items-center justify-between gap-4">
                  <time
                    class="font-mono text-sm text-muted-foreground tabular-nums"
                    datetime={issue.sentAt}
                  >
                    {formatSentAt(issue.sentAt)}
                  </time>
                  {issue.live ? (
                    <Flaps text="SENDING" label="Sending" live size="sm" delay={400} />
                  ) : (
                    <span class="text-muted-foreground">Sent</span>
                  )}
                </div>
                <p class="text-base font-medium text-pretty">
                  {issue.title}{" "}
                  <span class="font-normal text-nowrap text-muted-foreground">
                    · No. {issue.number}
                  </span>
                </p>
                <dl class="grid max-w-md grid-cols-[1.3fr_1fr_auto] gap-x-4">
                  <div class="flex flex-col gap-1">
                    <dt class="font-mono text-sm text-muted-foreground">Sent</dt>
                    <dd class="tabular-nums">
                      {formatCount(issue.sent)}
                      {issue.live && (
                        <span class="text-muted-foreground"> of {formatCount(issue.recipients)}</span>
                      )}
                    </dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="font-mono text-sm text-muted-foreground">Bounced</dt>
                    <dd class="tabular-nums">{formatCount(issue.bounced)}</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="font-mono text-sm text-muted-foreground">Unsubscribed</dt>
                    <dd class="tabular-nums">{formatCount(issue.unsubscribed)}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ul>
        <div class="-mx-5 -my-2 hidden overflow-x-auto whitespace-nowrap sm:-mx-8 lg:-mx-12 lg:block">
          <div class="inline-block min-w-full px-5 py-2 align-middle sm:px-8 lg:px-12">
            <table class="w-full border-collapse text-base">
              <thead>
                <tr class="text-left font-mono text-sm text-muted-foreground sm:text-xs">
                  <th class="border-b border-foreground pr-6 pb-3.5 font-normal">Date</th>
                  <th class="border-b border-foreground pr-6 pb-3.5 font-normal">Issue</th>
                  <th class="border-b border-foreground pr-6 pb-3.5 text-right font-normal">Sent</th>
                  <th class="border-b border-foreground pr-6 pb-3.5 text-right font-normal">
                    Bounced
                  </th>
                  <th class="border-b border-foreground pr-6 pb-3.5 text-right font-normal">
                    Unsubscribed
                  </th>
                  <th class="border-b border-foreground pb-3.5 text-right font-normal">Status</th>
                </tr>
              </thead>
              <tbody>
                {
                  issues.map((issue) => (
                    <tr>
                      <td class="border-b border-border py-5.5 pr-6 font-mono text-base text-muted-foreground tabular-nums sm:text-sm">
                        <time datetime={issue.sentAt}>{formatSentAt(issue.sentAt)}</time>
                      </td>
                      <td class="border-b border-border py-5.5 pr-6 font-medium">
                        {issue.title}{" "}
                        <span class="font-normal text-muted-foreground">· No. {issue.number}</span>
                      </td>
                      <td class="border-b border-border py-5.5 pr-6 text-right tabular-nums">
                        {issue.live ? (
                          <>
                            {formatCount(issue.sent)}{" "}
                            <span class="text-muted-foreground">
                              of {formatCount(issue.recipients)}
                            </span>
                          </>
                        ) : (
                          formatCount(issue.sent)
                        )}
                      </td>
                      <td class="border-b border-border py-5.5 pr-6 text-right tabular-nums">
                        {formatCount(issue.bounced)}
                      </td>
                      <td class="border-b border-border py-5.5 pr-6 text-right tabular-nums">
                        {formatCount(issue.unsubscribed)}
                      </td>
                      <td class="border-b border-border py-5.5 text-right">
                        {issue.live ? (
                          <Flaps text="SENDING" label="Sending" live size="sm" delay={400} />
                        ) : (
                          <span class="text-muted-foreground">Sent</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="flex scroll-mt-24 flex-col gap-14 pt-24 md:pt-44">
      <h2 class={sectionHeading} data-reveal>Three steps, then it’s just talking.</h2>
      <ol role="list" class:list={[autoFit, "[--reveal-delay:120ms]"]} data-reveal>
        {
          steps.map((step, index) => (
            <li
              class="row-span-5 grid grid-rows-subgrid justify-items-start gap-4"
            >
              <Flaps
                text={step.number}
                label={`Step ${step.number}`}
                size="lg"
                delay={300 + index * 150}
              />
              <h3 class="text-xl font-semibold tracking-tight">{step.title}</h3>
              <p class="text-base/7 text-pretty text-muted-foreground">{step.body}</p>
              <p class="rounded-lg bg-muted px-3 py-1.5 font-mono text-sm">{step.code}</p>
              <a href={step.href} class:list={[textLink, "min-h-8 text-base sm:text-[0.9375rem]"]}>
                {step.link} <Arrow size={14} />
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="mt-20 flex flex-col items-center gap-7 border-t border-border pt-20 pb-24 text-center md:mt-28 md:pt-28 md:pb-40"
    >
      <div data-reveal>
        <Mark size={56} />
      </div>
      <h2 class:list={[displayHeading, "[--reveal-delay:80ms]"]} data-reveal>
        Give your emails a <span class="sendoff-highlight text-nowrap">proper sendoff.</span>
      </h2>
      <p
        class="max-w-[48ch] text-lg/7 text-pretty text-muted-foreground [--reveal-delay:160ms]"
        data-reveal
      >
        Deploy to your own Cloudflare and AWS accounts, bring your list with you, and send the next
        issue from the chat.
      </p>
      <div class="[--reveal-delay:240ms]" data-reveal>
        <CopyCommand command={CREATE_COMMAND} />
      </div>
    </section>
  </div>

  <footer slot="footer" class="mx-auto max-w-300 px-5 sm:px-8 lg:px-12">
    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 pb-10 text-sm text-muted-foreground"
    >
      <div class="flex flex-wrap items-center gap-2">
        <Mark size={18} />
        <span class="font-semibold tracking-tight text-foreground">Sendoff</span>
        <span>Runs on Cloudflare Workers and Amazon SES</span>
      </div>
      <nav aria-label="Footer" class="flex items-center gap-5">
        <a href={DOCS} class="text-muted-foreground no-underline hover:text-foreground">Docs</a>
        <a href={REPO} class="text-muted-foreground no-underline hover:text-foreground">GitHub</a>
      </nav>
    </div>
  </footer>
</PageLayout>

<script>
  // On-view reveals. Each [data-reveal] element fades and rises into place the
  // first time it comes into view; with data-reveal="contents" the element
  // stays still and its children animate instead (theme.css has the states).
  // Anything already on screen is marked revealed before the hidden states
  // switch on, so nothing visible blinks out, and without script nothing is
  // hidden at all.
  const init = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            observer.unobserve(entry.target);
            entry.target.dataset.revealed = "";
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px" }
    );

    for (const element of document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not([data-revealed], [data-reveal-ready])"
    )) {
      element.dataset.revealReady = "";

      if (element.getBoundingClientRect().top < window.innerHeight) {
        element.dataset.revealed = "";
      } else {
        observer.observe(element);
      }
    }

    document.documentElement.dataset.motion = "";
  };

  // ClientRouter fires astro:page-load on every navigation; the ready flag keeps elements from being observed twice.
  init();

  document.addEventListener("astro:page-load", init);
</script>

<script>
  // The live preview mock's toggles. A click presses its button, unpresses the
  // others in its group, and sets data-<key> on the mock for its group-data
  // variants. Bundled scripts run once per session, so this delegates from
  // `document` and works on every visit to the page.
  document.addEventListener("click", (event) => {
    const button =
      event.target instanceof Element
        ? event.target.closest<HTMLElement>("[data-preview-key]")
        : null;

    const preview = button?.closest<HTMLElement>("[data-preview]");

    if (!(button && preview)) {
      return;
    }

    const { previewKey: key, previewValue: value } = button.dataset;

    if (!(key && value)) {
      return;
    }

    preview.dataset[key] = value;

    for (const option of preview.querySelectorAll(`[data-preview-key="${key}"]`)) {
      option.setAttribute("aria-pressed", String(option === button));
    }
  });
</script>
