---
// A row of split-flap tiles. Flaps are for live status and numbers only,
// never headlines; `live` flips them to signal yellow.
interface Props {
  text: string;
  label?: string;
  live?: boolean;
  size?: "sm" | "md" | "lg";
}

const { text, label = text, live = false, size = "md" } = Astro.props;

const sizes = {
  lg: "h-10 w-7.5 rounded-[5px] text-[1.375rem]",
  md: "h-7.5 w-5.5 rounded-sm text-[1.0625rem]",
  sm: "h-6.25 w-4.5 rounded-[3px] text-sm",
} as const;

const characters = [...text];
---

<span class="inline-flex gap-0.5" role="img" aria-label={label}>
  {
    characters.map((character) => (
      <span class:list={["sendoff-flap", sizes[size]]} data-live={live ? "" : undefined}>
        {character}
      </span>
    ))
  }
</span>
