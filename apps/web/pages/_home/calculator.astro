---
// The cost calculator: the inputs on the left (three starting points and a
// slider per field) and, on a muted panel, two receipts on the right: Resend's
// monthly bill and Sendoff's, itemized, with the yearly difference beneath.
// The page renders the middle preset, so the numbers are in the HTML for
// readers without script and for agents; the script only re-runs `estimate`
// (inlined from prices.ts as `estimateSource`, so both sides share one
// implementation) and refills the receipts from the line <template>. Astro's
// ClientRouter runs an inline script once per session, so this delegates from
// `document`, guarded by a global flag, and refreshes on every
// `astro:page-load` in case the browser restored the sliders to other positions.
import Mark from "./mark.astro";
import type { PricingInput } from "./prices.ts";
import { checked, estimate, estimateSource, fields, presets, prices, sources } from "./prices.ts";
import Receipt from "./receipt.astro";
import ReceiptLine from "./receipt-line.astro";
import ResendLogo from "./resend-logo.astro";

const [, initial] = presets;
const result = estimate(initial.input, prices);

const sliders = fields.map((field) => ({
  ...field,
  index: field.steps.indexOf(initial.input[field.key]),
}));

// A preset as slider positions, the form the script applies it in.
const positions = (input: PricingInput) =>
  Object.fromEntries(fields.map((field) => [field.key, field.steps.indexOf(input[field.key])]));

const assumptions = `Estimates, not quotes, checked ${checked}. Resend is priced on its Marketing plans, which are billed monthly by contact count with unlimited sends, and quoted individually above 150,000 contacts. Sendoff is priced on Cloudflare Workers Paid, whose included usage covers its database and queue at these volumes, and Amazon SES at $0.10 per 1,000 emails, before any AWS free tier. Bounce and click notifications through Amazon SNS add cents at most. A domain costs the same either way.`;

const pricingScript = `(()=>{if(window.__sendoffPricing){return;}window.__sendoffPricing=true;${estimateSource}const prices=${JSON.stringify(prices)};const read=(root)=>{const input={};for(const range of root.querySelectorAll("[data-field]")){const i=Number(range.value);const label=JSON.parse(range.dataset.labels)[i];input[range.dataset.field]=JSON.parse(range.dataset.steps)[i];range.style.setProperty("--pricing-progress",String(i/Number(range.max)));range.setAttribute("aria-valuetext",label);root.querySelector('[data-value-for="'+range.dataset.field+'"]').textContent=label;}return input;};const fill=(root,side,receipt)=>{const card=root.querySelector('[data-receipt="'+side+'"]');const row=root.querySelector("[data-line-template]").content.firstElementChild;card.querySelector("[data-lines]").replaceChildren(...receipt.lines.map((line)=>{const li=row.cloneNode(true);li.querySelector("[data-line-label]").textContent=line.label;li.querySelector("[data-line-amount]").textContent=line.amount;const note=li.querySelector("[data-line-note]");note.textContent=line.note;note.hidden=!line.note;return li;}));card.querySelector("[data-total]").textContent=receipt.total;card.querySelector("[data-yearly]").textContent=receipt.yearly;};const update=(root)=>{const result=estimate(read(root),prices);fill(root,"resend",result.resend);fill(root,"sendoff",result.sendoff);root.querySelector("[data-difference]").textContent=result.difference;};const refresh=()=>{for(const root of document.querySelectorAll("[data-pricing]")){update(root);}};document.addEventListener("input",(e)=>{const root=e.target instanceof Element&&e.target.closest("[data-pricing]");if(!root){return;}for(const b of root.querySelectorAll("[data-preset]")){b.setAttribute("aria-pressed","false");}update(root);});document.addEventListener("click",(e)=>{const button=e.target instanceof Element&&e.target.closest("[data-preset]");const root=button&&button.closest("[data-pricing]");if(!root){return;}const state=JSON.parse(button.dataset.preset);for(const range of root.querySelectorAll("[data-field]")){range.value=String(state[range.dataset.field]);}for(const b of root.querySelectorAll("[data-preset]")){b.setAttribute("aria-pressed",String(b===button));}update(root);});refresh();document.addEventListener("astro:page-load",refresh);})();`;
---

<div class="grid items-start gap-12 lg:grid-cols-[2fr_3fr]" data-pricing>
  <div class="flex flex-col gap-8">
    <div class="flex flex-col gap-3">
      <p class="text-base text-muted-foreground sm:text-sm" id="pricing-presets">Start from</p>
      <div aria-labelledby="pricing-presets" class="flex flex-wrap gap-2" role="group">
        {
          presets.map((preset) => (
            <button
              aria-pressed={preset.id === initial.id ? "true" : "false"}
              class="cursor-pointer rounded-full px-4 py-2 text-base ring-1 ring-border hover:bg-muted aria-pressed:bg-foreground aria-pressed:text-background aria-pressed:ring-foreground sm:px-3.5 sm:py-1.5 sm:text-sm"
              data-preset={JSON.stringify(positions(preset.input))}
              type="button"
            >
              {preset.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      sliders.map((slider) => (
        <div class="flex flex-col gap-3">
          <div class="flex items-baseline justify-between gap-4 text-base sm:text-sm">
            <label class="font-medium" for={`pricing-${slider.key}`}>
              {slider.label}
            </label>
            <output
              class="font-medium tabular-nums"
              data-value-for={slider.key}
              for={`pricing-${slider.key}`}
            >
              {slider.labels[slider.index]}
            </output>
          </div>
          <input
            aria-valuetext={slider.labels[slider.index]}
            autocomplete="off"
            class="pricing-range h-4 w-full cursor-pointer appearance-none bg-transparent"
            data-field={slider.key}
            data-labels={JSON.stringify(slider.labels)}
            data-steps={JSON.stringify(slider.steps)}
            id={`pricing-${slider.key}`}
            max={slider.steps.length - 1}
            min="0"
            name={`pricing-${slider.key}`}
            step="1"
            style={`--pricing-progress: ${slider.index / (slider.steps.length - 1)}`}
            type="range"
            value={slider.index}
          />
        </div>
      ))
    }
  </div>

  <div class="flex min-w-0 flex-col gap-6">
    <div class="grid gap-4 rounded-4xl bg-muted p-4 sm:grid-cols-2 sm:p-8">
      <Receipt name="Resend" receipt={result.resend} side="resend">
        <ResendLogo slot="logo" size={14} />
      </Receipt>
      <Receipt name="Sendoff" raised receipt={result.sendoff} side="sendoff">
        <Mark slot="logo" size={18} />
      </Receipt>
    </div>
    <p aria-live="polite" class="text-2xl font-medium text-balance" data-difference>
      {result.difference}
    </p>
    <p class="text-base/7 text-pretty text-muted-foreground sm:text-sm/6">
      {assumptions} Sources:{" "}
      {
        sources.map((source, index) => (
          <>
            <a
              class="text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
              href={source.href}
            >
              {source.label}
            </a>
            {index < sources.length - 1 ? ", " : "."}
          </>
        ))
      }
    </p>
  </div>

  <template data-line-template>
    <ReceiptLine line={{ amount: "", label: "", note: "" }} />
  </template>
</div>

<script is:inline set:html={pricingScript} />

<style>
  /* The sliders: a thin rail filled with the accent up to the thumb, with no
     native track or outline. Firefox fills it natively; elsewhere the fill is
     a gradient stopping at the thumb's center, which the script keeps in
     --pricing-progress. */
  .pricing-range {
    --pricing-fill: var(--blume-accent);
    --pricing-rail: color-mix(in oklab, var(--blume-foreground) 14%, transparent);
  }

  .pricing-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--pricing-fill) calc(8px + (100% - 16px) * var(--pricing-progress, 0)),
      var(--pricing-rail) 0
    );
  }

  .pricing-range::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    border: 0;
    border-radius: 9999px;
    background: var(--pricing-fill);
  }

  .pricing-range::-moz-range-track {
    height: 4px;
    border-radius: 9999px;
    background: var(--pricing-rail);
  }

  .pricing-range::-moz-range-progress {
    height: 4px;
    border-radius: 9999px;
    background: var(--pricing-fill);
  }

  .pricing-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 9999px;
    background: var(--pricing-fill);
  }

  /* Focus rings the thumb, not the whole bar. */
  .pricing-range:focus-visible {
    outline: none;
  }

  .pricing-range:focus-visible::-webkit-slider-thumb {
    box-shadow:
      0 0 0 2px var(--blume-background),
      0 0 0 4px var(--blume-accent);
  }

  .pricing-range:focus-visible::-moz-range-thumb {
    box-shadow:
      0 0 0 2px var(--blume-background),
      0 0 0 4px var(--blume-accent);
  }
</style>
